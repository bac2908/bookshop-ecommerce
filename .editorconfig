root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[{*.yml,*.yaml,*.json}]
indent_style = space
indent_size = 2

[{*.properties,*.xml,*.md,*.html,*.css,*.js,*.sql}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{*.cmd,*.ps1}]
end_of_line = crlf
