# Docker Compose development defaults (safe, local-only values)
MYSQL_DATABASE=bookshop
MYSQL_USER=bookshop
MYSQL_PASSWORD=bookshop_dev
MYSQL_ROOT_PASSWORD=bookshop_root_dev
MYSQL_PORT=3308

# Application overrides
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3308/bookshop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=bookshop
DB_PASSWORD=bookshop_dev
MAIL_USERNAME=
MAIL_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_REFUND_ENABLED=false
