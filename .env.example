# Docker Compose development defaults (safe, local-only values)
MYSQL_DATABASE=bookshop
MYSQL_USER=bookshop
MYSQL_PASSWORD=bookshop_dev
MYSQL_ROOT_PASSWORD=bookshop_root_dev
MYSQL_PORT=3308
APP_PORT=8080

# Optional integrations
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_REFUND_ENABLED=false
APP_SCHEDULING_ENABLED=true
AUTH_OTP_MAX_REQUESTS=5
AUTH_OTP_WINDOW_MINUTES=15
AUTH_OTP_CLEANUP_MS=900000

# Optional first administrator. Enable only for the first successful startup,
# use a unique password of at least 12 characters, then set enabled back to false.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrator
ADMIN_BOOTSTRAP_PHONE=
